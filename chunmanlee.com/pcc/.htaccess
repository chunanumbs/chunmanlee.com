Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:auth|gate)\.php$ - [L]
  RewriteRule ^$ gate.php?path=index.html [L,QSA]
  RewriteRule ^(.+)$ gate.php?path=$1 [L,QSA]
</IfModule>
